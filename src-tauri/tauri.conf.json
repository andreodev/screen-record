{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame Studio",
  "version": "0.1.0",
  "identifier": "com.andreodev.screenstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frame Studio — Captura",
        "width": 460,
        "height": 370,
        "minWidth": 420,
        "minHeight": 340,
        "decorations": false,
        "alwaysOnTop": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/studio-assets/": "studio-assets/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "framestudio"
        ],
        "name": "Frame Studio Project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-frame-studio-project",
        "exportedType": {
          "identifier": "com.andreodev.framestudio.project",
          "conformsTo": [
            "com.apple.package"
          ]
        }
      }
    ]
  }
}
